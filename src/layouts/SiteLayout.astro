---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ClipVault - a local-first clipboard manager for macOS",
  description = "Keep everything you copy, searchable from your Mac's menu bar. No account, no sync, no analytics, and no network.",
} = Astro.props;
const iconUrl = `${import.meta.env.BASE_URL}assets/icon.png`;
const heroImageUrl = `${import.meta.env.BASE_URL}assets/history-panel.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f3f6" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://ashinxavier.github.io/clipvault/" />
    <link rel="icon" type="image/png" href={iconUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href={heroImageUrl} fetchpriority="high" />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main"
      class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white shadow-lg transition-transform focus:translate-y-0"
    >Skip to content</a>
    <slot />
  </body>
</html>
